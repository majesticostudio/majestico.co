---
interface Project {
	title: string;
	image: string;
	isAlternate: boolean;
}

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<ul
	data-project-list
	class="absolute w-full will-change-transform list-none"
	data-projects={JSON.stringify(projects)}
>
	<div class="project template">
		<div class="side flex-1 h-full overflow-hidden">
			<div class="flex justify-between items-center">
				<h1
					class="uppercase text-[2.5rem] font-medium tracking-[-0.0125rem] p-2"
				>
					Euphoria
				</h1>
				<h1
					class="uppercase text-[2.5rem] font-medium tracking-[-0.0125rem] p-2"
				>
					I
				</h1>
			</div>
		</div>
		<div class="side flex-1 h-full overflow-hidden">
			<div class="w-full h-full overflow-hidden">
				<img
					class="relative w-full h-full object-cover will-change-transform translate-y-0 scale-150"
					src=""
					alt=""
				/>
			</div>
		</div>
	</div>
</ul>

<style>
	.project {
		width: 100%;
		height: 100vh;
		display: flex;
		overflow: hidden;
		position: absolute;
		left: 0;
		right: 0;
		will-change: transform;
		font-family: "SangBleu", sans-serif;
	}

	.project.template {
		display: none;
	}

	:global(.side) {
		flex: 1;
		height: 100%;
		overflow: hidden;
		padding: 5rem;
	}

	:global(::-webkit-scrollbar) {
		display: none;
	}

	:global(*) {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>

<script>
	const lerp = (start: number, end: number, factor: number): number =>
		start + (end - start) * factor;

	const config = {
		SCROLL_SPEED: 0.75,
		LERP_FACTOR: 0.05,
		BUFFER_SIZE: 15,
		CLEANUP_THRESHOLD: 50,
		MAX_VELOCITY: 120,
	};

	interface ProjectData {
		title: string;
		image: string;
		isAlternate: boolean;
	}

	// Get the data from the attribute
	const projectData: ProjectData[] = JSON.parse(
		(document.querySelector("[data-projects]") as HTMLElement)?.dataset
			.projects || "[]",
	);

	interface State {
		currentY: number;
		targetY: number;
		lastY: number;
		scrollVelocity: number;
		isDragging: boolean;
		startY: number;
		projects: Map<number, HTMLElement>;
		parallaxImages: Map<number, ParallaxImage>;
		projectHeight: number;
		lastScrollTime: number;
		isScrolling: boolean;
	}

	interface Bounds {
		top: number;
		bottom: number;
	}

	interface ParallaxImage {
		update: (scroll: number) => void;
		updateBounds: () => void;
	}

	const state: State = {
		currentY: 0,
		targetY: 0,
		lastY: 0,
		scrollVelocity: 0,
		isDragging: false,
		startY: 0,
		projects: new Map(),
		parallaxImages: new Map(),
		projectHeight: window.innerHeight,
		lastScrollTime: Date.now(),
		isScrolling: false,
	};

	const createParallaxImage = (imageElement: HTMLElement): ParallaxImage => {
		let bounds: Bounds | null = null;
		let currentTranslateY = 0;
		let targetTranslateY = 0;
		let lastScrollPosition = 0;
		let scrollVelocity = 0;

		const updateBounds = (): void => {
			if (imageElement) {
				const rect = imageElement.getBoundingClientRect();
				bounds = {
					top: rect.top + window.scrollY,
					bottom: rect.bottom + window.scrollY,
				};
			}
		};

		const update = (scroll: number): void => {
			if (!bounds) return;

			// Calculate scroll velocity for dynamic parallax
			scrollVelocity = scroll - lastScrollPosition;
			lastScrollPosition = scroll;

			// Base parallax effect
			const relativeScroll = -scroll - bounds.top;
			// Add a velocity component to the parallax for scrubbing effect
			targetTranslateY = relativeScroll * 0.3 + scrollVelocity * 0.1;

			// Smooth transition
			currentTranslateY = lerp(currentTranslateY, targetTranslateY, 0.08);

			// Apply with slight directional scale effect for more dynamic feeling
			const scaleEffect = 1.5 + Math.abs(scrollVelocity) * 0.001;
			imageElement.style.transform = `translateY(${currentTranslateY}px) scale(${scaleEffect})`;
		};

		updateBounds();
		return { update, updateBounds };
	};

	const getProjectData = (index: number): ProjectData => {
		const dataIndex =
			((Math.abs(index) % projectData.length) + projectData.length) %
			projectData.length;
		return projectData[dataIndex];
	};

	const toRomanNumeral = (num: number): string => {
		const romanNumerals = [
			{ value: 100, numeral: "C" },
			{ value: 90, numeral: "XC" },
			{ value: 50, numeral: "L" },
			{ value: 40, numeral: "XL" },
			{ value: 10, numeral: "X" },
			{ value: 9, numeral: "IX" },
			{ value: 5, numeral: "V" },
			{ value: 4, numeral: "IV" },
			{ value: 1, numeral: "I" },
		];

		let result = "";

		for (const { value, numeral } of romanNumerals) {
			while (num >= value) {
				result += numeral;
				num -= value;
			}
		}

		return result;
	};

	const createProjectElement = (index: number): void => {
		if (state.projects.has(index)) return;

		const template = document.querySelector(".template");
		const project = template?.cloneNode(true) as HTMLElement;
		project.classList.remove("template");
		project.style.display = "flex";

		const dataIndex =
			((Math.abs(index) % projectData.length) + projectData.length) %
			projectData.length;
		const data = getProjectData(index);
		const projectNumber = dataIndex + 1;
		const romanNumber = toRomanNumeral(projectNumber);

		project.innerHTML = data.isAlternate
			? `<div class="side flex-1 h-full overflow-hidden">
         <div class="w-full h-full overflow-hidden">
           <img class="relative w-full h-full object-cover will-change-transform translate-y-0 scale-150" src="${data.image}" alt="${data.title}" />
         </div>
       </div>
       <div class="side flex-1 h-full overflow-hidden">
         <div class="flex justify-between items-center">
           <h1 class="uppercase text-[2.5rem] font-medium tracking-[-0.0125rem] p-2">${data.title}</h1>
           <h1 class="uppercase text-[2.5rem] font-medium tracking-[-0.0125rem] p-2">${romanNumber}</h1>
         </div>
       </div>`
			: `<div class="side flex-1 h-full overflow-hidden">
         <div class="flex justify-between items-center">
           <h1 class="uppercase text-[2.5rem] font-medium tracking-[-0.0125rem] p-2">${data.title}</h1>
           <h1 class="uppercase text-[2.5rem] font-medium tracking-[-0.0125rem] p-2">${romanNumber}</h1>
         </div>
       </div>
       <div class="side flex-1 h-full overflow-hidden">
         <div class="w-full h-full overflow-hidden">
           <img class="relative w-full h-full object-cover will-change-transform translate-y-0 scale-150" src="${data.image}" alt="${data.title}" />
         </div>
       </div>`;

		project.style.transform = `translateY(${index * state.projectHeight}px)`;
		(
			document.querySelector("[data-project-list]") as HTMLElement
		).appendChild(project);
		state.projects.set(index, project);

		const img = project?.querySelector("img") as HTMLElement;
		if (img) {
			state.parallaxImages.set(index, createParallaxImage(img));
		}
	};

	const createInitialProjects = (): void => {
		for (let i = -config.BUFFER_SIZE; i <= config.BUFFER_SIZE; i++) {
			createProjectElement(i);
		}
	};

	const getCurrentIndex = (): number =>
		Math.round(-state.targetY / state.projectHeight);

	const checkAndCreateProjects = (): void => {
		const currentIndex = getCurrentIndex();
		const minNeeded = currentIndex - config.BUFFER_SIZE;
		const maxNeeded = currentIndex + config.BUFFER_SIZE;

		for (let i = minNeeded; i <= maxNeeded; i++) {
			if (!state.projects.has(i)) {
				createProjectElement(i);
			}
		}

		state.projects.forEach((project, index) => {
			if (
				index < currentIndex - config.CLEANUP_THRESHOLD ||
				index > currentIndex + config.CLEANUP_THRESHOLD
			) {
				project.remove();
				state.projects.delete(index);
				state.parallaxImages.delete(index);
			}
		});
	};

	const animate = (): void => {
		if (!state.isDragging) {
			state.currentY +=
				(state.targetY - state.currentY) * config.LERP_FACTOR;
		}

		checkAndCreateProjects();

		state.projects.forEach((project, index) => {
			const y = index * state.projectHeight + state.currentY;
			project.style.transform = `translateY(${y}px)`;

			const parallaxImage = state.parallaxImages.get(index);
			if (parallaxImage) {
				parallaxImage.update(state.currentY);
			}
		});

		requestAnimationFrame(animate);
	};

	const handleWheel = (e: WheelEvent): void => {
		e.preventDefault();
		state.lastScrollTime = Date.now();

		const scrollDelta = e.deltaY * config.SCROLL_SPEED;
		state.targetY -= Math.max(
			Math.min(scrollDelta, config.MAX_VELOCITY),
			-config.MAX_VELOCITY,
		);
	};

	const handleTouchStart = (e: TouchEvent): void => {
		state.isDragging = true;
		state.startY = e.touches[0].clientY;
		state.lastY = state.targetY;
		state.lastScrollTime = Date.now();
	};

	const handleTouchMove = (e: TouchEvent): void => {
		if (!state.isDragging) return;
		const deltaY = (e.touches[0].clientY - state.startY) * 1.5;
		state.targetY = state.lastY + deltaY;
		state.lastScrollTime = Date.now();
	};

	const handleTouchEnd = (): void => {
		state.isDragging = false;
	};

	const handleResize = (): void => {
		state.projectHeight = window.innerHeight;
		state.projects.forEach((project, index) => {
			project.style.transform = `translateY(${index * state.projectHeight}px)`;
			const parallaxImage = state.parallaxImages.get(index);
			if (parallaxImage) {
				parallaxImage.updateBounds();
			}
		});
	};

	const initializeScroll = (): void => {
		window.addEventListener("wheel", handleWheel, { passive: false });
		window.addEventListener("touchstart", handleTouchStart);
		window.addEventListener("touchmove", handleTouchMove);
		window.addEventListener("touchend", handleTouchEnd);
		window.addEventListener("resize", handleResize);

		createInitialProjects();
		animate();
	};

	document.addEventListener("DOMContentLoaded", initializeScroll);
</script>
