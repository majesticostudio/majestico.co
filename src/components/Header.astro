---
// https://www.youtube.com/watch?v=QG8x_l3sGSc&list=PL8bX3D8aBEpl6UHVuum_WYYfWHsiY5Liw&index=30
// https://www.youtube.com/watch?v=l59wLe1paos&list=PL8bX3D8aBEpl6UHVuum_WYYfWHsiY5Liw&index=24

import { Image } from "astro:assets";
import headerConfig from "@/data/singletons/header.json";

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/**/*.{webp,jpeg,jpg,png,gif,svg}",
);
---

<header class="fixed p-2 lg:p-4 top-0 right-0 left-0 z-20 max-w-[40rem]">
	<nav
		id="header-nav"
		class="w-12 h-12 flex flex-col bg-black overflow-hidden"
	>
		<div
			class="w-12 h-12 min-h-12 cursor-pointer flex items-center justify-center"
		>
			<div class="text-white text-2xl font-bold">M</div>
		</div>
		<div
			id="menu-content"
			class="opacity-0 pointer-events-none flex flex-col grow"
		>
			<!-- Menu items -->
			<div
				id="menu-items"
				class="flex-1 flex flex-col justify-start p-4 pt-20"
			>
				{
					headerConfig.menuItems.map((item) => (
						<a
							href={item.href}
							class="menu-item font-display text-white text-4xl mb-4"
							data-menu-item
						>
							{item.label}
						</a>
					))
				}
			</div>

			<!-- Bottom section with contacts and socials -->
			<div class="flex-1 flex justify-between items-end p-4">
				<!-- Contacts -->
				<div id="contacts">
					{
						headerConfig.contacts.map((contact) => (
							<a
								href={contact.href}
								class="contact-item text-white text-xl block"
							>
								{contact.label}
							</a>
						))
					}
				</div>

				<!-- Socials -->
				<div id="socials">
					{
						headerConfig.socials.map((social) => (
							<a
								href={social.href}
								class="social-item text-white text-xl block mb-2"
							>
								{social.label}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</nav>
</header>

<script>
	import { gsap } from "gsap";

	const headerNav = document.querySelector("#header-nav");
	const menuContent = document.querySelector("#menu-content");
	const menuItems = document.querySelectorAll(".menu-item");
	const contactItems = document.querySelectorAll(".contact-item");
	const socialItems = document.querySelectorAll(".social-item");
	let isOpen = false;

	// Opening animation
	const openAnimation = gsap
		.timeline({
			paused: true,
			defaults: { duration: 0.8, ease: "power4.out" },
		})
		.set(headerNav, {
			maxWidth: "40rem",
		})
		.set(menuContent, {
			opacity: 1,
			pointerEvents: "auto",
		})
		.to(headerNav, {
			width: "100%",
			height: "calc(100vh - 2rem)",
		})
		.from(
			menuItems,
			{
				x: -80,
				opacity: 0,
				stagger: 0.1,
				duration: 0.6,
			},
			"<=+0.2",
		);

	// Closing animation
	const closeAnimation = gsap
		.timeline({
			paused: true,
			defaults: { duration: 0.8, ease: "power4.out" },
		})
		// Reset menu items, contacts, and socials
		.to([menuItems, contactItems, socialItems], {
			opacity: 0,
			x: -80,
			stagger: {
				from: "end",
				amount: 0.05,
			},
			duration: 0.3,
		})
		.to(
			headerNav,
			{
				width: "3rem",
				height: "3rem",
			},
			"<",
		)
		.to(
			menuContent,
			{
				opacity: 0,
				pointerEvents: "none",
			},
			"<=+0.1",
		);

	// For desktop
	if (window.matchMedia("(min-width: 768px)").matches) {
		headerNav?.addEventListener("mouseenter", () => {
			if (!isOpen) {
				closeAnimation.pause(0);
				openAnimation.play(0);
				isOpen = true;
			}
		});

		headerNav?.addEventListener("mouseleave", () => {
			if (isOpen) {
				openAnimation.pause();
				closeAnimation.play(0);
				isOpen = false;
			}
		});
	}
	// For mobile
	else {
		headerNav?.addEventListener("click", () => {
			if (isOpen) {
				openAnimation.pause();
				closeAnimation.play(0);
			} else {
				closeAnimation.pause(0);
				openAnimation.play(0);
			}
			isOpen = !isOpen;
		});
	}
</script>

<style>
	#header-nav {
		position: relative;
		transition: background-color 0.3s;
	}

	.menu-item,
	.contact-item,
	.social-item {
		transition: color 0.3s ease;
	}

	.menu-item:hover,
	.contact-item:hover,
	.social-item:hover {
		color: #888;
	}
</style>
