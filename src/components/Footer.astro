---
import { Image } from "astro:assets";
import footerConfig from "@/data/singletons/footer.json";

// Define types for footer configuration
interface SocialLink {
	platform: string;
	url: string;
	icon?: string;
}

interface FooterConfig {
	email?: string;
	address?: {
		link?: string;
		text: string;
	};
	legalInfo?: string;
	socialLinks?: SocialLink[];
}

// Use type assertion to ensure footerConfig matches our interface
const typedConfig = footerConfig as FooterConfig;

// Default values if properties are not set
const email = typedConfig.email || "info@example.com";
const address = typedConfig.address || {
	text: "Via Example 123, Milano, Italy",
};
const legalInfo = typedConfig.legalInfo || "P.IVA 12345678901";
const socialLinks = typedConfig.socialLinks || [];

// Function to get icon path for social media
const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/**/*.{webp,jpeg,jpg,png,gif,svg}",
);
---

<footer
	class="flex flex-col md:flex-row justify-between gap-4 px-5 lg:px-8 py-4"
>
	<a href={`mailto:${email}`}>{email}</a>
	{
		address.link ? (
			<a href={address.link} target="_blank" rel="noopener noreferrer">
				{address.text}
			</a>
		) : (
			<span>{address.text}</span>
		)
	}
	<span>{legalInfo}</span>

	{
		socialLinks && socialLinks.length > 0 && (
			<div class="flex gap-4">
				{socialLinks.map((social) => (
					<a
						href={social.url}
						target="_blank"
						rel="noopener noreferrer"
						class="text-black hover:text-gray-700"
					>
						{social.icon ? (
							<Image
								src={images[social.icon]()}
								alt={social.platform}
								class="w-6 h-6"
							/>
						) : (
							social.platform
						)}
					</a>
				))}
			</div>
		)
	}
</footer>
