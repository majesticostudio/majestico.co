---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import settings from "@/data/singletons/settings.json";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";

interface Props extends AstroSeoProps {
	ogImage?: string;
	hideHeader?: boolean;
	hideFooter?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const { ogImage, hideHeader, hideFooter, ...rest } = Astro.props;

const pathWithSlash = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;

const defaultSeo: AstroSeoProps = {
	title: settings.defaultSeo.title,
	description: settings.defaultSeo.description,
	canonical: canonicalURL,
	openGraph: {
		title: settings.defaultSeo.title,
		site_name: settings.defaultSeo.title,
		type: "website",
		url: canonicalURL,
		images: [
			{
				url:
					ogImage ??
					settings.defaultSeo.ogImage ??
					new URL("og.png", new URL(pathWithSlash, Astro.site)).toString(),
				width: 1200,
				height: 630,
				alt: settings.defaultSeo.title,
			},
		],
	},
};

const seo = { ...defaultSeo, ...rest };
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={settings.style.primaryColor} />
		<meta name="publisher" content={settings.defaultSeo.author} />
		<meta name="author" content={settings.defaultSeo.author} />
		<AstroSeo {...seo} />

		<script
			is:inline
			defer
			src="https://umami.majestico.co/script.js"
			data-website-id={settings.tracking.umami}></script>

		<script src="/src/scripts/revealOnScroll.ts"></script>
		<ClientRouter />
	</head>
	<body>
		{!hideHeader && <Header />}
		<slot />
		{!hideFooter && <Footer />}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
