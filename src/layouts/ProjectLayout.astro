---
// https://www.youtube.com/watch?v=bOX-WCXYi8c&list=PL8bX3D8aBEpnxsHw-B_592tg7C0v6n_ov&index=4

import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";

interface Props {
	project: CollectionEntry<"projects">;
	prevProject?: CollectionEntry<"projects">;
	nextProject?: CollectionEntry<"projects">;
}

const { project, prevProject, nextProject, ...props } = Astro.props;
---

<style>
	.sticky-title {
		position: sticky;
		top: 2rem;
		z-index: 50;
	}
</style>

<Layout {...props} hideFooter={true}>
	<div
		class="project-page"
		id="project-page"
		data-prev-project-id={prevProject?.id}
		data-next-project-id={nextProject?.id}
	>
		<div
			class="min-h-screen flex flex-col justify-center items-center px-4 sm:px-8"
			id="projectHero"
		>
			<p class="text-xs mb-8 opacity-0 pb-12">Next Project</p>
			<div
				class="hidden sm:flex items-center justify-center gap-8 w-full max-w-[64rem]"
			>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 opacity-0"
				>
					<div class="absolute inset-0 bg-black"></div>
				</div>
				<h1
					class="text-4xl sm:text-5xl text-center whitespace-nowrap font-display sticky-title"
					id="projectTitle"
				>
					{project.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 opacity-0"
				>
					<div class="absolute inset-0 bg-black"></div>
				</div>
			</div>
			{/* Mobile version */}
			<div
				class="sm:hidden flex flex-col items-center w-full gap-20 xl:gap-40 max-w-[24rem]"
			>
				<h1
					class="text-4xl text-center font-display sticky-title"
					id="projectTitleMobile"
				>
					{project.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 opacity-0 max-w-32"
				>
					<div class="absolute inset-0 bg-black"></div>
				</div>
			</div>
			<p class="text-sm mt-8 opacity-0">Keep Scrolling</p>
		</div>

		<div class="h-[300vh]"></div>

		<slot />

		<div
			class="min-h-screen flex flex-col justify-center items-center px-4 sm:px-8"
			id="projectFooter"
		>
			<p
				class="text-xs mb-8 opacity-60 transition-opacity duration-300 pb-12"
				id="nextProjectLabel"
				data-element-fade-out
			>
				Next Project
			</p>
			<div
				class="hidden sm:flex items-center justify-center gap-8 w-full max-w-[64rem]"
			>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10"
					data-element-fade-out
				>
					<div
						class="absolute inset-0 bg-black origin-right scale-x-0"
						id="leftProgressBar"
					>
					</div>
				</div>
				<h1
					class="text-4xl sm:text-5xl text-center whitespace-nowrap font-display"
					id="nextProjectTitle"
				>
					{nextProject?.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10"
					data-element-fade-out
				>
					<div
						class="absolute inset-0 bg-black origin-left scale-x-0"
						id="rightProgressBar"
					>
					</div>
				</div>
			</div>

			{/* Mobile version */}
			<div
				class="sm:hidden flex flex-col items-center w-full gap-20 xl:gap-40 max-w-[24rem]"
			>
				<h1
					class="text-4xl text-center font-display"
					id="nextProjectTitleMobile"
				>
					{nextProject?.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 max-w-32"
					data-element-fade-out
				>
					<div
						class="absolute w-1/2 left-0 inset-y-0 bg-black origin-right scale-x-0"
						id="leftProgressBarMobile"
					>
					</div>
					<div
						class="absolute w-1/2 right-0 inset-y-0 bg-black origin-left scale-x-0"
						id="rightProgressBarMobile"
					>
					</div>
				</div>
			</div>
			<p
				class="text-sm mt-8 opacity-60 transition-opacity duration-300"
				id="keepScrollingLabel"
				data-element-fade-out
			>
				Keep Scrolling
			</p>
		</div>
	</div>
</Layout>

<script>
	// Import GSAP in a way that works with Astro
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { navigate } from "astro:transitions/client";

	// Initialize animations on page load
	document.addEventListener("astro:page-load", () => {
		let isTransitioning = false;
		let shouldUpdateProgress = true;
		const projectPage = document.getElementById("project-page");
		const progressBar = document.getElementById("progressBar");
		const projectFooter = document.getElementById("projectFooter");
		const projectTitle = document.getElementById("projectTitle");
		const nextProjectTitle = document.getElementById("nextProjectTitle");
		const nextProjectTitleMobile = document.getElementById(
			"nextProjectTitleMobile",
		);
		const nextProjectLabel = document.getElementById("nextProjectLabel");
		const keepScrollingLabel =
			document.getElementById("keepScrollingLabel");
		const leftProgressBar = document.getElementById("leftProgressBar");
		const rightProgressBar = document.getElementById("rightProgressBar");
		const leftProgressBarMobile = document.getElementById(
			"leftProgressBarMobile",
		);
		const rightProgressBarMobile = document.getElementById(
			"rightProgressBarMobile",
		);
		const nextProjectId = projectPage?.dataset.nextProjectId;

		// Register ScrollTrigger plugin
		gsap.registerPlugin(ScrollTrigger);

		// Function to apply sticky behavior to a title element
		function applyStickyBehavior(titleElement) {
			if (!titleElement) return;

			let titleOriginalPosition = null;
			let titleOriginalRect = null;

			// Get the original position of the title
			function saveOriginalPosition() {
				if (!titleElement) return;

				titleOriginalPosition = titleElement.getBoundingClientRect();
				titleOriginalRect = {
					top: window.scrollY + titleOriginalPosition.top,
					left: titleOriginalPosition.left,
					width: titleOriginalPosition.width,
					height: titleOriginalPosition.height,
					x: titleOriginalPosition.x,
				};
			}

			saveOriginalPosition();

			// Function to handle scroll
			function handleScroll() {
				if (!titleOriginalRect || !titleElement) return;

				const scrollTop = window.scrollY;
				const topThreshold = titleOriginalRect.top - 16; // 1rem (16px)

				// Calculate how close we are to the threshold for scaling
				const distanceToThreshold =
					titleOriginalRect.top - (scrollTop + 16);
				// Only start scaling when we're closer to the top (last 20% of distance)
				const maxDistance = window.innerHeight / 5;
				const linearProgress = Math.max(
					0,
					Math.min(1, 1 - distanceToThreshold / maxDistance),
				);

				// Apply cubic easing (similar to Power3.out)
				const progress =
					linearProgress * linearProgress * (3 - 2 * linearProgress);

				// Scale from 1 to 0.3 based on scroll progress
				const scale = 1 - 0.7 * progress;

				if (scrollTop > topThreshold) {
					// Title should be fixed
					if (titleElement.style.position !== "fixed") {
						titleElement.style.position = "fixed";
						titleElement.style.top = "1rem";
						titleElement.style.left = "50%";
						titleElement.style.width = `${titleOriginalRect.width}px`;
						titleElement.style.transform = `translateX(-50%) scale(${scale})`;
						titleElement.style.zIndex = "50";
					} else {
						// Just update the scale if already fixed
						titleElement.style.transform = `translateX(-50%) scale(${scale})`;
					}
				} else {
					// Reset position but animate scale
					titleElement.style.position = "";
					titleElement.style.top = "";
					titleElement.style.left = "";
					titleElement.style.width = "";
					titleElement.style.transform = `scale(${scale})`;
					titleElement.style.zIndex = "50";
				}
			}

			// Attach scroll event
			window.addEventListener("scroll", handleScroll);

			// Update on window resize
			window.addEventListener("resize", () => {
				saveOriginalPosition();
				handleScroll();
			});

			// Initial check
			handleScroll();
		}

		// Apply sticky behavior to both desktop and mobile titles
		applyStickyBehavior(projectTitle);
		applyStickyBehavior(document.getElementById("projectTitleMobile"));

		// Footer animation and navigation
		if (projectFooter) {
			// Create a main timeline for all animations
			const tl = gsap.timeline({
				scrollTrigger: {
					trigger: projectFooter,
					start: "top top",
					end: `+=${window.innerHeight * 3}px`,
					pin: true,
					pinSpacing: true,
					scrub: 1,
					onLeave: () => {
						if (!isTransitioning && nextProjectId) {
							isTransitioning = true;
							navigate(`/projects/${nextProjectId}`);
						}
					},
				},
			});

			// Add animations to the timeline
			// Progress bars animation
			tl.to(
				[
					leftProgressBar,
					rightProgressBar,
					leftProgressBarMobile,
					rightProgressBarMobile,
				].filter(Boolean),
				{
					scaleX: 1,
					duration: 1,
					ease: "none",
				},
				0,
			);

			// Fade out elements
			tl.to(
				"[data-element-fade-out]",
				{
					opacity: 0,
					duration: 0.3,
					ease: "none",
				},
				0.7,
			); // Start at 70% of the scroll

			// Cleanup for ScrollTrigger on navigation
			document.addEventListener("astro:before-preparation", () => {
				ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
			});
		}
	});
</script>
