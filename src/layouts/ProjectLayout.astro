---
// https://www.youtube.com/watch?v=bOX-WCXYi8c&list=PL8bX3D8aBEpnxsHw-B_592tg7C0v6n_ov&index=4

import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";

interface Props {
	project: CollectionEntry<"projects">;
	prevProject?: CollectionEntry<"projects">;
	nextProject?: CollectionEntry<"projects">;
}

const { project, prevProject, nextProject, ...props } = Astro.props;

// Function to convert number to Roman numeral
function toRoman(num: number): string {
	const romanNumerals = [
		{ value: 1000, numeral: "M" },
		{ value: 900, numeral: "CM" },
		{ value: 500, numeral: "D" },
		{ value: 400, numeral: "CD" },
		{ value: 100, numeral: "C" },
		{ value: 90, numeral: "XC" },
		{ value: 50, numeral: "L" },
		{ value: 40, numeral: "XL" },
		{ value: 10, numeral: "X" },
		{ value: 9, numeral: "IX" },
		{ value: 5, numeral: "V" },
		{ value: 4, numeral: "IV" },
		{ value: 1, numeral: "I" },
	];

	let result = "";
	// Create a copy of num to avoid modifying the parameter
	let remaining = num;

	for (const { value, numeral } of romanNumerals) {
		while (remaining >= value) {
			result += numeral;
			remaining -= value;
		}
	}

	return result;
}

const projectRomanNumeral = project.data.order
	? toRoman(project.data.order)
	: "";
---

<Layout {...props} hideFooter={true}>
	<div
		class="project-page"
		id="project-page"
		data-prev-project-id={prevProject?.id}
		data-next-project-id={nextProject?.id}
	>
		<div
			class="min-h-screen flex flex-col justify-center items-center px-4 sm:px-8"
			id="projectHero"
		>
			<div
				class="flex flex-col items-center w-full max-w-[24rem] sm:max-w-[64rem]"
			>
				<div class="flex items-center justify-center w-full gap-8">
					<div
						class="flex flex-col items-center sticky top-8 z-50 sm:w-auto pb-[7.3rem] md:pb-40"
					>
						{
							projectRomanNumeral && (
								<p class="text-sm font-display tracking-wider opacity-70 pb-20 font-normal">
									{projectRomanNumeral}
								</p>
							)
						}
						<h1
							class="text-3xl sm:text-5xl md:text-6xl text-center whitespace-nowrap font-display"
							id="projectTitle"
						>
							{project.data.title}
						</h1>
					</div>
				</div>
			</div>
		</div>

		<div data-expand-on-scroll class="-mt-40 flex justify-center">
			<Image
				src={project.data.cover}
				alt={project.data.title}
				class="w-full h-full object-cover"
			/>
		</div>

		<div class="h-[300vh]"></div>

		<slot />

		<!-- Footer Section -->
		<div
			class="min-h-screen flex flex-col justify-center items-center px-4 sm:px-8 pb-10 md:pb-[6.5rem]"
			id="projectFooter"
		>
			<p
				class="text-xs mb-8 opacity-60 transition-opacity duration-300 pb-12"
				id="nextProjectLabel"
				data-element-fade-out
			>
				Next Project
			</p>

			<div
				class="flex flex-col sm:flex-row items-center justify-center w-full max-w-[24rem] sm:max-w-[64rem] sm:gap-8"
			>
				<div
					class="hidden sm:block relative w-full h-[0.0625rem] bg-black/10"
					data-element-fade-out
				>
					<div
						class="absolute inset-0 bg-black origin-right scale-x-0"
						id="leftProgressBar"
					>
					</div>
				</div>

				<h1
					class="text-3xl sm:text-5xl md:text-6xl text-center whitespace-nowrap font-display"
					id="nextProjectTitle"
				>
					{nextProject?.data.title}
				</h1>

				<!-- Right progress bar (desktop) -->
				<div
					class="hidden sm:block relative w-full h-[0.0625rem] bg-black/10"
					data-element-fade-out
				>
					<div
						class="absolute inset-0 bg-black origin-left scale-x-0"
						id="rightProgressBar"
					>
					</div>
				</div>

				<!-- Mobile progress bar -->
				<div
					class="sm:hidden relative w-full h-[0.0625rem] bg-black/10 max-w-32 mt-5"
					data-element-fade-out
				>
					<div
						class="absolute w-1/2 left-0 inset-y-0 bg-black origin-right scale-x-0"
						id="leftProgressBarMobile"
					>
					</div>
					<div
						class="absolute w-1/2 right-0 inset-y-0 bg-black origin-left scale-x-0"
						id="rightProgressBarMobile"
					>
					</div>
				</div>
			</div>

			<p
				class="text-sm pt-8 opacity-60 transition-opacity duration-300"
				id="keepScrollingLabel"
				data-element-fade-out
			>
				Keep Scrolling
			</p>
		</div>
	</div>
</Layout>

<style>
	[data-expand-on-scroll] {
		--negative-margin: calc(15 * var(--svh, 1svh));
		--anim-progress: 0;
		--scroll-progress: 0;
		--parallax-progress: -200px;
		clip-path: inset(
			calc(
					(1 - var(--anim-progress, 1)) * var(--negative-margin) +
						(1 - var(--scroll-progress, 1)) * 10%
				)
				calc(
					20% * (1 - var(--anim-progress, 1)) +
						(1 - var(--scroll-progress, 1)) * 30%
				)
				0
				calc(
					20% * (1 - var(--anim-progress, 1)) +
						(1 - var(--scroll-progress, 1)) * 30%
				)
		);
	}
	[data-expand-on-scroll] img {
		transform: translate3d(0px, var(--parallax-progress), 0px);
	}
</style>

<script>
	// Import GSAP in a way that works with Astro
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { navigate } from "astro:transitions/client";

	// Initialize animations on page load
	document.addEventListener("astro:page-load", () => {
		let isTransitioning = false;
		const projectPage = document.getElementById("project-page");
		const projectFooter = document.getElementById("projectFooter");
		const projectTitle = document.getElementById("projectTitle");
		const nextProjectId = projectPage?.dataset.nextProjectId;

		// Register ScrollTrigger plugin
		gsap.registerPlugin(ScrollTrigger);

		// Define types for DOM elements and position data
		interface TitleRect {
			top: number;
			left: number;
			width: number;
			height: number;
			x: number;
		}

		// Function to apply sticky behavior to a title element
		function applyStickyBehavior(titleElement: HTMLElement): void {
			if (!titleElement) return;

			let titleOriginalPosition: DOMRect | null = null;
			let titleOriginalRect: TitleRect | null = null;

			// Get the original position of the title
			function saveOriginalPosition(): void {
				if (!titleElement) return;

				titleOriginalPosition = titleElement.getBoundingClientRect();
				titleOriginalRect = {
					top: window.scrollY + titleOriginalPosition.top,
					left: titleOriginalPosition.left,
					width: titleOriginalPosition.width,
					height: titleOriginalPosition.height,
					x: titleOriginalPosition.x,
				};
			}

			saveOriginalPosition();

			// Function to handle scroll
			function handleScroll(): void {
				if (!titleOriginalRect || !titleElement) return;

				const scrollTop = window.scrollY;
				const topThreshold = titleOriginalRect.top - 16; // 1rem (16px)

				// Calculate how close we are to the threshold for scaling
				const distanceToThreshold =
					titleOriginalRect.top - (scrollTop + 16);
				// Only start scaling when we're closer to the top (last 20% of distance)
				const maxDistance = window.innerHeight / 5;
				const linearProgress = Math.max(
					0,
					Math.min(1, 1 - distanceToThreshold / maxDistance),
				);

				// Apply cubic easing (similar to Power3.out)
				const progress =
					linearProgress * linearProgress * (3 - 2 * linearProgress);

				// Determine if we're on mobile based on viewport width
				const isMobile = window.innerWidth < 768; // 768px is typical mobile breakpoint

				// Scale differently based on device size
				// Desktop: 1 to 0.25, Mobile: 1 to 0.5
				const scaleReduction = isMobile ? 0.5 : 0.75;
				const scale = 1 - scaleReduction * progress;

				if (scrollTop > topThreshold) {
					// Title should be fixed
					if (titleElement.style.position !== "fixed") {
						titleElement.style.position = "fixed";
						titleElement.style.top = "1rem";
						titleElement.style.left = "50%";
						titleElement.style.width = `${titleOriginalRect.width}px`;
						titleElement.style.transform = `translateX(-50%) scale(${scale})`;
						titleElement.style.zIndex = "50";
					} else {
						// Just update the scale if already fixed
						titleElement.style.transform = `translateX(-50%) scale(${scale})`;
					}
				} else {
					// Reset position but animate scale
					titleElement.style.position = "";
					titleElement.style.top = "";
					titleElement.style.left = "";
					titleElement.style.width = "";
					titleElement.style.transform = `scale(${scale})`;
					titleElement.style.zIndex = "50";
				}
			}

			// Attach scroll event
			window.addEventListener("scroll", handleScroll);

			// Update on window resize
			window.addEventListener("resize", () => {
				saveOriginalPosition();
				handleScroll();
			});

			// Initial check
			handleScroll();
		}

		// Apply sticky behavior to title
		if (projectTitle) applyStickyBehavior(projectTitle);

		// Footer animation and navigation
		if (projectFooter) {
			// Create a main timeline for all animations
			const tl = gsap.timeline({
				scrollTrigger: {
					trigger: projectFooter,
					start: "top top",
					end: `+=${window.innerHeight * 3}px`,
					pin: true,
					pinSpacing: true,
					scrub: 1,
					onLeave: () => {
						if (!isTransitioning && nextProjectId) {
							isTransitioning = true;
							navigate(`/projects/${nextProjectId}`);
						}
					},
				},
			});

			// Select progress bar elements
			const progressElements = [
				document.getElementById("leftProgressBar"),
				document.getElementById("rightProgressBar"),
				document.getElementById("leftProgressBarMobile"),
				document.getElementById("rightProgressBarMobile"),
			].filter(Boolean);

			// Add animations to the timeline
			// Progress bars animation
			tl.to(
				progressElements,
				{
					scaleX: 1,
					duration: 1,
					ease: "none",
				},
				0,
			);

			// Fade out elements
			tl.to(
				"[data-element-fade-out]",
				{
					opacity: 0,
					duration: 0.3,
					ease: "none",
				},
				0.7,
			); // Start at 70% of the scroll

			// Cleanup for ScrollTrigger on navigation
			document.addEventListener("astro:before-preparation", () => {
				ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
			});
		}

		// Image expand on scroll
		const sectionExpandOnScroll = document.querySelectorAll(
			"[data-expand-on-scroll]",
		);
		sectionExpandOnScroll.forEach((section) => {
			const sectionElement = section as HTMLElement;
			const imageElement = sectionElement.querySelector("img");
			// Set initial state
			sectionElement.style.setProperty("--anim-progress", "0");
			sectionElement.style.setProperty(
				"--scroll-progress",
				window.innerWidth < 768 ? "0.8" : "0",
			);

			gsap.to(sectionElement, {
				ease: "power2.out",
				duration: 1,
				"--anim-progress": "1",
			});
			// After initial animation, set up scroll animation
			gsap.to(sectionElement, {
				scrollTrigger: {
					trigger: sectionElement,
					start: "top 80%",
					end: "center center",
					scrub: 0.8,
				},
				ease: "none",
				"--scroll-progress": "1",
			});

			// Add parallax effect
			gsap.to(imageElement, {
				scrollTrigger: {
					trigger: sectionElement,
					start: "top 80%",
					end: "bottom top",
					scrub: true,
				},
				"--parallax-progress": window.innerWidth < 768 ? 500 : 600,
				ease: "none",
			});
		});
	});
</script>
