---
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";

interface Props {
	project: CollectionEntry<"projects">;
	prevProject?: CollectionEntry<"projects">;
	nextProject?: CollectionEntry<"projects">;
}

const { project, prevProject, nextProject, ...props } = Astro.props;

const nextProjectSlug = nextProject?.id;
---

<Layout {...props} hideFooter={true}>
	<div
		class="project-page"
		data-prev-project-id={prevProject?.id}
		data-next-project-id={nextProject?.id}
	>
		<div
			class="fixed top-0 left-0 right-0 bg-white flex justify-between items-center px-4 sm:px-8 py-4 z-50"
			id="projectNav"
			data-prev-project-id={prevProject?.id}
			data-next-project-id={nextProject?.id}
		>
			{
				prevProject && (
					<div class="flex items-center">
						<span>&#8592;&nbsp;</span>
						<a
							href={`/projects/${prevProject.id}`}
							class="hover:opacity-70 transition-opacity"
						>
							Previous
						</a>
					</div>
				)
			}

			<div class="w-full max-w-[20rem]">
				<p class="text-sm">{project.data.title}</p>
				<div
					class="w-full h-[0.0625rem] bg-black origin-left scale-x-0"
					id="progressBar"
				>
				</div>
			</div>

			{
				nextProject && (
					<div class="flex items-center">
						<a
							href={`/projects/${nextProject.id}`}
							class="hover:opacity-70 transition-opacity"
						>
							Next
						</a>
						<span>&nbsp;&#8594;</span>
					</div>
				)
			}
		</div>

		<div
			class="min-h-screen flex flex-col justify-center items-center px-4 sm:px-8"
			id="projectHero"
		>
			<p class="text-xs mb-8 opacity-0 pb-12">Next Project</p>
			<div
				class="hidden sm:flex items-center justify-center gap-8 w-full max-w-[64rem]"
			>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 opacity-0"
				>
					<div class="absolute inset-0 bg-black"></div>
				</div>
				<h1
					class="text-4xl sm:text-5xl text-center whitespace-nowrap"
					id="projectTitle"
				>
					{project.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 opacity-0"
				>
					<div class="absolute inset-0 bg-black"></div>
				</div>
			</div>
			{/* Mobile version */}
			<div
				class="sm:hidden flex flex-col items-center w-full gap-20 xl:gap-40 max-w-[24rem]"
			>
				<h1 class="text-4xl text-center" id="projectTitleMobile">
					{project.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 opacity-0 max-w-32"
				>
					<div class="absolute inset-0 bg-black"></div>
				</div>
			</div>
			<p class="text-sm mt-8 opacity-0">Keep Scrolling</p>
		</div>

		<div class="h-[300vh]"></div>

		<slot />

		<div
			class="min-h-screen flex flex-col justify-center items-center px-4 sm:px-8"
			id="projectFooter"
		>
			<p
				class="text-xs mb-8 opacity-60 transition-opacity duration-300 pb-12"
				id="nextProjectLabel"
				data-element-fade-out
			>
				Next Project
			</p>
			<div
				class="hidden sm:flex items-center justify-center gap-8 w-full max-w-[64rem]"
			>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10"
					data-element-fade-out
				>
					<div
						class="absolute inset-0 bg-black origin-right scale-x-0"
						id="leftProgressBar"
					>
					</div>
				</div>
				<h1
					class="text-4xl sm:text-5xl text-center whitespace-nowrap"
					id="nextProjectTitle"
				>
					{nextProject?.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10"
					data-element-fade-out
				>
					<div
						class="absolute inset-0 bg-black origin-left scale-x-0"
						id="rightProgressBar"
					>
					</div>
				</div>
			</div>

			{/* Mobile version */}
			<div
				class="sm:hidden flex flex-col items-center w-full gap-20 xl:gap-40 max-w-[24rem]"
			>
				<h1 class="text-4xl text-center" id="nextProjectTitleMobile">
					{nextProject?.data.title}
				</h1>
				<div
					class="relative w-full h-[0.0625rem] bg-black/10 max-w-32"
					data-element-fade-out
				>
					<div
						class="absolute w-1/2 left-0 inset-y-0 bg-black origin-right scale-x-0"
						id="leftProgressBarMobile"
					>
					</div>
					<div
						class="absolute w-1/2 right-0 inset-y-0 bg-black origin-left scale-x-0"
						id="rightProgressBarMobile"
					>
					</div>
				</div>
			</div>
			<p
				class="text-sm mt-8 opacity-60 transition-opacity duration-300"
				id="keepScrollingLabel"
				data-element-fade-out
			>
				Keep Scrolling
			</p>
		</div>
	</div>
</Layout>

<script>
	// Import GSAP in a way that works with Astro
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { navigate } from "astro:transitions/client";

	// Initialize animations on page load
	document.addEventListener("astro:page-load", () => {
		let isTransitioning = false;
		let shouldUpdateProgress = true;
		const projectNav = document.getElementById("projectNav");
		const progressBar = document.getElementById("progressBar");
		const projectFooter = document.getElementById("projectFooter");
		const projectTitle = document.getElementById("projectTitle");
		const nextProjectTitle = document.getElementById("nextProjectTitle");
		const nextProjectTitleMobile = document.getElementById(
			"nextProjectTitleMobile",
		);
		const nextProjectLabel = document.getElementById("nextProjectLabel");
		const keepScrollingLabel =
			document.getElementById("keepScrollingLabel");
		const leftProgressBar = document.getElementById("leftProgressBar");
		const rightProgressBar = document.getElementById("rightProgressBar");
		const leftProgressBarMobile = document.getElementById(
			"leftProgressBarMobile",
		);
		const rightProgressBarMobile = document.getElementById(
			"rightProgressBarMobile",
		);
		const nextProjectId = projectNav?.dataset.nextProjectId;

		// Register ScrollTrigger plugin
		gsap.registerPlugin(ScrollTrigger);

		// Footer animation and navigation
		if (projectFooter) {
			// Create a main timeline for all animations
			const tl = gsap.timeline({
				scrollTrigger: {
					trigger: projectFooter,
					start: "top top",
					end: `+=${window.innerHeight * 3}px`,
					pin: true,
					pinSpacing: true,
					scrub: 1,
					onLeave: () => {
						if (!isTransitioning && nextProjectId) {
							isTransitioning = true;
							navigate(`/projects/${nextProjectId}`);
						}
					},
				},
			});

			// Add animations to the timeline
			// Progress bars animation
			tl.to(
				[
					leftProgressBar,
					rightProgressBar,
					leftProgressBarMobile,
					rightProgressBarMobile,
				].filter(Boolean),
				{
					scaleX: 1,
					duration: 1,
					ease: "none",
				},
				0,
			);

			// Fade out elements
			tl.to(
				"[data-element-fade-out]",
				{
					opacity: 0,
					duration: 0.3,
					ease: "none",
				},
				0.7,
			); // Start at 70% of the scroll

			// Nav animation
			tl.to(
				projectNav,
				{
					opacity: 0,
					y: "-6rem",
					duration: 0.3,
					ease: "none",
				},
				0,
			);

			// Cleanup for ScrollTrigger on navigation
			document.addEventListener("astro:before-preparation", () => {
				ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
			});
		}
	});
</script>
