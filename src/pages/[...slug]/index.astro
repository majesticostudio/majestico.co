---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getCollectionPaths } from "@/lib/collectionHelpers";

export interface Props {
	data: CollectionEntry<"pages">;
}

export const getStaticPaths = getCollectionPaths("pages");

const { data: page } = Astro.props;
const { Content, headings } = await render(page);
---

<Layout
	{...page.data.seo}
	hideHeader={page.data.hideHeader}
	hideFooter={page.data.hideFooter}
>
	<Content />
</Layout>
